chat.smtop100.blog {
    encode zstd gzip

    @public path /login /login/* /share /manifest.webmanifest /pwa-sw.js /top100-chat-icon.svg /auth/claim /auth/check /auth/logout
    handle @public {
        reverse_proxy 127.0.0.1:1470
    }

    @push path /push/*
    handle @push {
        forward_auth 127.0.0.1:1470 {
            uri /auth/check
        }
        reverse_proxy 127.0.0.1:1470
    }

    handle {
        forward_auth 127.0.0.1:1470 {
            uri /auth/check
        }

        header {
            X-Robots-Tag "noindex, nofollow, noarchive"
            Referrer-Policy "same-origin"
        }

        @websocket header Upgrade websocket
        reverse_proxy @websocket 127.0.0.1:1463
        reverse_proxy 127.0.0.1:1430
    }
}
